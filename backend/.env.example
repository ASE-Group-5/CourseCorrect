# Copy this file to `.env` (never commit `.env`).

# Neon "pooled" connection string (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon "direct" connection string (no "-pooler"). Used by Alembic migrations.
# Optional: if omitted, migrations fall back to DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
